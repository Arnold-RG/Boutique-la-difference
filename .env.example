# Copy to .env and fill in. Never commit .env.

HOST=0.0.0.0
PORT=8080

# Sign-in for /admin. The username is not stored in the repository.
ADMIN_USERNAME=

# Output of: node server/hash-password.js
ADMIN_PASSWORD_HASH=

# Long random string. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Hours before a session cookie expires.
SESSION_HOURS=8

# Set to 1 only when a reverse proxy sets X-Forwarded-For and X-Forwarded-Proto.
TRUST_PROXY=0
